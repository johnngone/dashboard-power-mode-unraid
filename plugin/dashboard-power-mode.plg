<?xml version="1.0" encoding="UTF-8"?>
<PLUGIN name="dashboard-power-mode" author="johnngone" version="2026.11.16.1" min="7.0.0" pluginURL="https://raw.githubusercontent.com/johnngone/dashboard-power-mode-unraid/main/plugin/dashboard-power-mode.plg" support="https://github.com/johnngone/dashboard-power-mode-unraid/issues" icon="fa-bolt">
  <CHANGES>Place adjustment controls below the existing Processor display.
Add sampled GHz readings in one column per core load row.
Hardware detection, persistent settings, and Tips and Tweaks conflict detection.
</CHANGES>
