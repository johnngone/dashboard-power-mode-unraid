  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/README.md" Mode="0644">
    <INLINE>**Dashboard Power Mode**

Governor selection, a Turbo Boost checkbox, and a hardware-aware frequency ceiling below the Processor display, plus sampled GHz readings beside CPU load bars.

Open **Dashboard → Processor**. Selections apply and save automatically. Release the frequency slider to save its value.

Requires Unraid 7.0+. Other CPU managers can override these settings; Tips and Tweaks is left unchanged.

https://github.com/johnngone/dashboard-power-mode-unraid
</INLINE>
    <SHA256>73f802d59e76ea5b924ff78f5388e7382992340fb30cab85467bd2532ed32887</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/api.php" Mode="0644">
    <INLINE>&lt;?php
/* SPDX-License-Identifier: GPL-2.0-only */
declare(strict_types=1);

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');

function dpm_error(int $code, string $message): void
{
    http_response_code($code);
    echo json_encode(['error' =&gt; $message]);
    exit;
}

// Unraid's global prepend checks CSRF on every POST before this file runs.
// Refuse service under a PHP configuration which would bypass that protection.
$prepend = realpath((string)ini_get('auto_prepend_file'));
if ($prepend !== realpath('/usr/local/emhttp/webGui/include/local_prepend.php') || $prepend === false) {
    dpm_error(503, 'Unraid web authentication and CSRF setup is required.');
}
if (session_status() !== PHP_SESSION_ACTIVE) session_start();
if (!isset($_SESSION['unraid_login'])) dpm_error(401, 'Sign in to Unraid first.');
session_write_close();

require_once __DIR__.'/include/PowerControl.php';
$power = new \DashboardPowerMode\PowerControl();
try {
    if ($_SERVER['REQUEST_METHOD'] === 'GET') {
        if (isset($_GET['frequencies'])) {
            require_once __DIR__.'/include/CpuFrequency.php';
            echo json_encode(['frequencies_khz' =&gt; (object)\DashboardPowerMode\CpuFrequency::read()], JSON_THROW_ON_ERROR);
        } else {
            echo json_encode($power-&gt;status(), JSON_THROW_ON_ERROR);
        }
    } elseif ($_SERVER['REQUEST_METHOD'] === 'POST') {
        $values = $_POST;
        if (array_key_exists('turbo', $values)) {
            if (!in_array($values['turbo'], ['0', '1'], true)) throw new InvalidArgumentException('Invalid turbo value.');
            $values['turbo'] = $values['turbo'] === '1';
        }
        if (array_key_exists('max_freq_khz', $values)) {
            $cap = $values['max_freq_khz'];
            if (!is_string($cap) || !ctype_digit($cap) || strlen($cap) &gt; 10) throw new InvalidArgumentException('Invalid frequency cap.');
            $values['max_freq_khz'] = (int)$cap;
        }
        echo json_encode($power-&gt;apply($values), JSON_THROW_ON_ERROR);
    } else {
        header('Allow: GET, POST');
        dpm_error(405, 'Use GET or POST.');
    }
} catch (InvalidArgumentException $error) {
    dpm_error(422, $error-&gt;getMessage());
} catch (Throwable $error) {
    error_log('dashboard-power-mode: '.$error-&gt;getMessage());
    dpm_error(409, $error-&gt;getMessage());
}
</INLINE>
    <SHA256>00d5e2715c9defdeebaf2a7a00bbd95de01d487fe3de8220703e014745785e4c</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/include/CpuFrequency.php" Mode="0644">
    <INLINE>&lt;?php
/* SPDX-License-Identifier: GPL-2.0-only */
declare(strict_types=1);

namespace DashboardPowerMode;

final class CpuFrequency
{
    /** Sampled frequencies reported by Linux, keyed by logical CPU number. */
    public static function read(string $path = '/proc/cpuinfo'): array
    {
        $contents = @file_get_contents($path);
        if ($contents === false) return [];
        $cpu = null;
        $values = [];
        foreach (explode("\n", $contents) as $line) {
            if (trim($line) === '') {
                $cpu = null;
            } elseif (preg_match('/^processor\s*:\s*(\d+)\s*$/', $line, $match)) {
                $cpu = (int)$match[1];
            } elseif ($cpu !== null &amp;&amp; preg_match('/^cpu MHz\s*:\s*(\d+(?:\.\d+)?)\s*$/', $line, $match)) {
                $khz = (int)round((float)$match[1] * 1000);
                if ($khz &gt; 0) $values[$cpu] = $khz;
            }
        }
        return $values;
    }
}
</INLINE>
    <SHA256>679e2bdf61dcdff3adcce926addee848661f84fc76e59bf550a8fee3d0797562</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/include/PowerControl.php" Mode="0644">
    <INLINE>&lt;?php
/* SPDX-License-Identifier: GPL-2.0-only */
declare(strict_types=1);

namespace DashboardPowerMode;

final class PowerControl
{
    private string $root;
    private string $config;
    private string $lock;
    private string $tips;
    private $writer;
    private $reader;

    public function __construct(
        string $root = '/sys/devices/system/cpu',
        string $config = '/boot/config/plugins/dashboard-power-mode/settings.json',
        string $lock = '/var/lock/dashboard-power-mode.lock',
        string $tips = '/boot/config/plugins/tips.and.tweaks/tips.and.tweaks.cfg',
        ?callable $writer = null,
        ?callable $reader = null
    ) {
        $this-&gt;root = rtrim($root, '/');
        $this-&gt;config = $config;
        $this-&gt;lock = $lock;
        $this-&gt;tips = $tips;
        $this-&gt;writer = $writer;
        $this-&gt;reader = $reader;
    }

    private function read(string $path): string
    {
        $value = $this-&gt;reader !== null ? ($this-&gt;reader)($path) : @file_get_contents($path);
        if ($value === false) {
            throw new \RuntimeException('Cannot read CPU control: '.basename($path));
        }
        return trim($value);
    }

    private function number(string $path): int
    {
        $value = $this-&gt;read($path);
        if (!ctype_digit($value) || (int)$value &lt;= 0) {
            throw new \RuntimeException('Invalid CPU frequency reported by the kernel.');
        }
        return (int)$value;
    }

    private function write(string $path, string $value): void
    {
        if ($this-&gt;writer !== null) {
            ($this-&gt;writer)($path, $value);
        } elseif (@file_put_contents($path, $value."\n") === false) {
            throw new \RuntimeException('Cannot write CPU control: '.basename($path));
        }
    }

    private function settle(string $path, string $expected): string
    {
        // CPUFreq QoS updates can complete asynchronously after a successful sysfs write.
        for ($attempt = 0; $attempt &lt; 20; $attempt++) {
            $actual = $this-&gt;read($path);
            if ($actual === $expected) return $actual;
            usleep(5000);
        }
        return $this-&gt;read($path);
    }

    private function policyPaths(): array
    {
        $paths = glob($this-&gt;root.'/cpufreq/policy[0-9]*', GLOB_ONLYDIR) ?: [];
        // Legacy CPUFreq layouts may expose only cpuN/cpufreq symlinks.
        if (!$paths) {
            foreach (glob($this-&gt;root.'/cpu[0-9]*/cpufreq', GLOB_ONLYDIR) ?: [] as $path) {
                $paths[] = realpath($path) ?: $path;
            }
        }
        $paths = array_values(array_unique($paths));
        sort($paths, SORT_NATURAL);
        return array_values(array_filter($paths, static function ($path) {
            return is_readable($path.'/scaling_governor');
        }));
    }

    private function turboControls(array $paths): array
    {
        $intel = $this-&gt;root.'/intel_pstate/no_turbo';
        $global = $this-&gt;root.'/cpufreq/boost';
        if (is_readable($intel)) {
            return [['path' =&gt; $intel, 'inverted' =&gt; true]];
        }
        if (is_readable($global)) {
            return [['path' =&gt; $global, 'inverted' =&gt; false]];
        }
        $controls = [];
        foreach ($paths as $path) {
            if (!is_readable($path.'/boost')) {
                return []; // A server-wide toggle must cover every policy.
            }
            $controls[] = ['path' =&gt; $path.'/boost', 'inverted' =&gt; false];
        }
        return $controls;
    }

    private function uniform(array $values)
    {
        return $values &amp;&amp; count(array_unique($values, SORT_REGULAR)) === 1 ? $values[0] : null;
    }

    public function status(): array
    {
        $paths = $this-&gt;policyPaths();
        $policies = [];
        $common = null;
        $governorWritable = (bool)$paths;
        $capWritable = (bool)$paths;
        foreach ($paths as $path) {
            $governors = preg_split('/\s+/', $this-&gt;read($path.'/scaling_available_governors'), -1, PREG_SPLIT_NO_EMPTY);
            $common = $common === null ? $governors : array_values(array_intersect($common, $governors));
            $governorWritable = $governorWritable &amp;&amp; is_writable($path.'/scaling_governor');
            $hasCap = is_readable($path.'/scaling_min_freq') &amp;&amp; is_readable($path.'/scaling_max_freq')
                &amp;&amp; is_readable($path.'/cpuinfo_min_freq') &amp;&amp; is_readable($path.'/cpuinfo_max_freq');
            $capWritable = $capWritable &amp;&amp; $hasCap &amp;&amp; is_writable($path.'/scaling_max_freq');
            $policies[] = [
                'id' =&gt; basename($path),
                'driver' =&gt; is_readable($path.'/scaling_driver') ? $this-&gt;read($path.'/scaling_driver') : 'unknown',
                'governors' =&gt; $governors,
                'governor' =&gt; $this-&gt;read($path.'/scaling_governor'),
                'min_khz' =&gt; $hasCap ? $this-&gt;number($path.'/scaling_min_freq') : null,
                'max_khz' =&gt; $hasCap ? $this-&gt;number($path.'/scaling_max_freq') : null,
                'hw_min_khz' =&gt; $hasCap ? $this-&gt;number($path.'/cpuinfo_min_freq') : null,
                'hw_max_khz' =&gt; $hasCap ? $this-&gt;number($path.'/cpuinfo_max_freq') : null,
            ];
        }
        $common = $common ?: [];
        sort($common);
        $controls = $this-&gt;turboControls($paths);
        $boost = [];
        $turboWritable = (bool)$controls;
        foreach ($controls as $control) {
            $value = $this-&gt;read($control['path']);
            $turboWritable = $turboWritable &amp;&amp; is_writable($control['path']) &amp;&amp; in_array($value, ['0', '1'], true);
            $boost[] = $value === ($control['inverted'] ? '0' : '1');
        }
        $min = $capWritable ? max(array_column($policies, 'min_khz')) : null;
        $max = $capWritable ? min(array_column($policies, 'hw_max_khz')) : null;
        $tips = is_readable($this-&gt;tips) ? @parse_ini_file($this-&gt;tips, false, INI_SCANNER_RAW) : [];
        $conflict = !empty($tips['CPU_GOVERNOR']) || ($tips['SCHEDULED'] ?? 'no') === 'yes'
            || ($tips['TURBO_SCHEDULE'] ?? 'no') === 'yes';
        return [
            'policies' =&gt; $policies,
            'drivers' =&gt; array_values(array_unique(array_column($policies, 'driver'))),
            'governors' =&gt; $common,
            'governor_supported' =&gt; (bool)$paths &amp;&amp; $governorWritable &amp;&amp; (bool)$common,
            'governor' =&gt; $this-&gt;uniform(array_column($policies, 'governor')),
            'presets' =&gt; [
                'efficiency' =&gt; in_array('powersave', $common, true) ? 'powersave' : null,
                'balanced' =&gt; in_array('ondemand', $common, true) ? 'ondemand'
                    : (in_array('balance_power', $common, true) ? 'balance_power' : null),
                'performance' =&gt; in_array('performance', $common, true) ? 'performance' : null,
            ],
            'turbo' =&gt; ['supported' =&gt; $turboWritable, 'enabled' =&gt; $this-&gt;uniform($boost)],
            'frequency' =&gt; [
                'supported' =&gt; (bool)$paths &amp;&amp; $capWritable &amp;&amp; $min &lt;= $max,
                'min_khz' =&gt; $min, 'max_khz' =&gt; $max,
                'cap_khz' =&gt; $this-&gt;uniform(array_column($policies, 'max_khz')),
                'effective_caps_khz' =&gt; array_values(array_unique(array_filter(array_column($policies, 'max_khz')))),
            ],
            'tips_conflict' =&gt; $conflict,
            'saved' =&gt; $this-&gt;load(),
        ];
    }

    private function load(): array
    {
        if (!file_exists($this-&gt;config)) {
            return [];
        }
        $data = json_decode($this-&gt;read($this-&gt;config), true);
        if (!is_array($data) || array_diff(array_keys($data), ['governor', 'turbo', 'max_freq_khz'])) {
            throw new \RuntimeException('Saved power settings are invalid. Restore settings.json from backup or remove it.');
        }
        return $data;
    }

    private function save(array $data): void
    {
        $dir = dirname($this-&gt;config);
        if (!is_dir($dir) &amp;&amp; !@mkdir($dir, 0700, true) &amp;&amp; !is_dir($dir)) {
            throw new \RuntimeException('Cannot create the plugin configuration directory.');
        }
        $temporary = @tempnam($dir, '.settings-');
        if ($temporary === false) {
            throw new \RuntimeException('Cannot save power settings.');
        }
        try {
            if (@file_put_contents($temporary, json_encode($data, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n") === false) {
                throw new \RuntimeException('Cannot save power settings.');
            }
            @chmod($temporary, 0600);
            if (!@rename($temporary, $this-&gt;config)) {
                throw new \RuntimeException('Cannot replace saved power settings.');
            }
        } finally {
            if (file_exists($temporary)) {
                @unlink($temporary);
            }
        }
    }

    private function validate(array $values, array $status): void
    {
        if (!$values || array_diff(array_keys($values), ['governor', 'turbo', 'max_freq_khz'])) {
            throw new \InvalidArgumentException('Supply only governor, turbo, or max_freq_khz.');
        }
        if (array_key_exists('governor', $values)
            &amp;&amp; (!$status['governor_supported'] || !is_string($values['governor'])
                || !in_array($values['governor'], $status['governors'], true))) {
            throw new \InvalidArgumentException('Governor is not available on every CPU policy.');
        }
        if (array_key_exists('turbo', $values) &amp;&amp; (!$status['turbo']['supported'] || !is_bool($values['turbo']))) {
            throw new \InvalidArgumentException('Turbo control is unavailable or its value is invalid.');
        }
        if (array_key_exists('max_freq_khz', $values)) {
            $cap = $values['max_freq_khz'];
            // Some kernels lower cpuinfo_max_freq while turbo is off. Validate
            // the upper bound again after an explicitly requested turbo enable.
            $enablingTurbo = ($values['turbo'] ?? null) === true &amp;&amp; $status['turbo']['enabled'] !== true;
            if (!$status['frequency']['supported'] || !is_int($cap)
                || $cap &lt; $status['frequency']['min_khz'] || $cap &lt;= 0 || $cap &gt; 100000000
                || (!$enablingTurbo &amp;&amp; $cap &gt; $status['frequency']['max_khz'])) {
                throw new \InvalidArgumentException('Frequency cap must be within the displayed hardware range and above every policy minimum.');
            }
        }
    }

    /** Changed fields only; omitted controls are left alone. */
    public function apply(array $values, bool $persist = true): array
    {
        $handle = @fopen($this-&gt;lock, 'c');
        if ($handle === false || !flock($handle, LOCK_EX | LOCK_NB)) {
            if (is_resource($handle)) fclose($handle);
            throw new \RuntimeException('Another power change is running. Try again.');
        }
        $snapshot = [];
        try {
            $before = $this-&gt;status();
            $this-&gt;validate($values, $before);
            $paths = $this-&gt;policyPaths();
            $controls = $this-&gt;turboControls($paths);
            // Turbo changes can also modify both policy limits. Capture those side effects.
            foreach ($paths as $path) {
                foreach (['scaling_governor', 'scaling_min_freq', 'scaling_max_freq'] as $file) {
                    if (is_readable($path.'/'.$file)) $snapshot[$path.'/'.$file] = $this-&gt;read($path.'/'.$file);
                }
            }
            foreach ($controls as $control) $snapshot[$control['path']] = $this-&gt;read($control['path']);
            try {
                if (array_key_exists('turbo', $values)) {
                    foreach ($controls as $control) {
                        $raw = $values['turbo'] !== $control['inverted'] ? '1' : '0';
                        $this-&gt;write($control['path'], $raw);
                        if ($this-&gt;read($control['path']) !== $raw) throw new \RuntimeException('Kernel did not accept the turbo setting.');
                    }
                    usleep(10000);
                    if ($values['turbo'] === true) $this-&gt;validate($values, $this-&gt;status());
                }
                if (isset($values['governor'])) {
                    foreach ($paths as $path) {
                        $this-&gt;write($path.'/scaling_governor', $values['governor']);
                        if ($this-&gt;read($path.'/scaling_governor') !== $values['governor']) {
                            throw new \RuntimeException('Kernel did not accept the governor.');
                        }
                    }
                }
                if (isset($values['max_freq_khz'])) {
                    foreach ($paths as $path) {
                        $this-&gt;write($path.'/scaling_max_freq', (string)$values['max_freq_khz']);
                        $expected = min($values['max_freq_khz'], $this-&gt;number($path.'/cpuinfo_max_freq'));
                        $accepted = (int)$this-&gt;settle($path.'/scaling_max_freq', (string)$expected);
                        if ($accepted &lt; $this-&gt;number($path.'/scaling_min_freq') || $accepted &gt; $values['max_freq_khz']) {
                            throw new \RuntimeException('Kernel did not accept the frequency ceiling.');
                        }
                    }
                }
                foreach ($paths as $path) {
                    if (isset($snapshot[$path.'/scaling_min_freq'])
                        &amp;&amp; $this-&gt;read($path.'/scaling_min_freq') !== $snapshot[$path.'/scaling_min_freq']) {
                        throw new \RuntimeException('Kernel changed a CPU minimum frequency; change rejected to preserve your minimum settings.');
                    }
                }
                $after = $this-&gt;status();
                if ($persist) {
                    $this-&gt;save(array_replace($before['saved'], $values));
                    $after['saved'] = array_replace($before['saved'], $values);
                }
                return $after;
            } catch (\Throwable $error) {
                $failures = [];
                // Restore turbo first, then original bounds in an order that cannot cross.
                foreach ($controls as $control) {
                    try {
                        $this-&gt;write($control['path'], $snapshot[$control['path']]);
                        if ($this-&gt;read($control['path']) !== $snapshot[$control['path']]) {
                            throw new \RuntimeException('Turbo rollback readback mismatch.');
                        }
                    }
                    catch (\Throwable $ignored) { $failures[] = 'turbo'; }
                }
                foreach ($paths as $path) {
                    try {
                        if (isset($snapshot[$path.'/scaling_min_freq'], $snapshot[$path.'/scaling_max_freq'])) {
                            $oldMin = $snapshot[$path.'/scaling_min_freq'];
                            $oldMax = $snapshot[$path.'/scaling_max_freq'];
                            if ((int)$oldMax &lt; $this-&gt;number($path.'/scaling_min_freq')) {
                                $this-&gt;write($path.'/scaling_min_freq', $oldMin);
                                $this-&gt;settle($path.'/scaling_min_freq', $oldMin);
                                $this-&gt;write($path.'/scaling_max_freq', $oldMax);
                                $this-&gt;settle($path.'/scaling_max_freq', $oldMax);
                            } else {
                                $this-&gt;write($path.'/scaling_max_freq', $oldMax);
                                $this-&gt;settle($path.'/scaling_max_freq', $oldMax);
                                $this-&gt;write($path.'/scaling_min_freq', $oldMin);
                                $this-&gt;settle($path.'/scaling_min_freq', $oldMin);
                            }
                        }
                        $this-&gt;write($path.'/scaling_governor', $snapshot[$path.'/scaling_governor']);
                        foreach (['scaling_governor', 'scaling_min_freq', 'scaling_max_freq'] as $file) {
                            if (isset($snapshot[$path.'/'.$file]) &amp;&amp; $this-&gt;read($path.'/'.$file) !== $snapshot[$path.'/'.$file]) {
                                throw new \RuntimeException('Rollback readback mismatch.');
                            }
                        }
                    } catch (\Throwable $ignored) { $failures[] = basename($path); }
                }
                throw new \RuntimeException($error-&gt;getMessage().($failures
                    ? ' Rollback incomplete; inspect CPU settings: '.implode(', ', array_unique($failures))
                    : ' Previous CPU settings restored.'), 0, $error);
            }
        } finally {
            flock($handle, LOCK_UN);
            fclose($handle);
        }
    }

    public function restore(): array
    {
        $values = $this-&gt;load();
        // A new installation must not write CPU controls.
        if (!$values) return $this-&gt;status();
        if (($values['turbo'] ?? null) === false &amp;&amp; isset($values['max_freq_khz']) &amp;&amp; is_int($values['max_freq_khz'])) {
            // Retain the saved requested ceiling, but honor a turbo-disabled
            // kernel's narrower range when reapplying it at boot.
            $state = $this-&gt;status();
            if ($state['frequency']['supported']) {
                $values['max_freq_khz'] = min($values['max_freq_khz'], $state['frequency']['max_khz']);
            }
        }
        return $this-&gt;apply($values, false);
    }
}
</INLINE>
    <SHA256>54aaafcb607bf47fcdcf6bea9960f36440d7f17a1dc07d261fbf76b7beda2415</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/javascript/power-mode.js" Mode="0644">
    <INLINE>/* SPDX-License-Identifier: GPL-2.0-only */
(() =&gt; {
  'use strict';
  const endpoint = '/plugins/dashboard-power-mode/api.php';
  function init() {
    let root = document.getElementById('dashboard-power-mode');
    if (!root || root.dataset.initialized) return;
    const processor = document.getElementById('cpu_main')?.closest('tbody');
    if (processor &amp;&amp; processor !== root &amp;&amp; root.tagName === 'TBODY') {
      const section = document.createElement('div');
      section.id = root.id;
      section.className = 'dpm-adjustments';
      // Keep the controls inside Processor so native sorting and collapsing
      // move them together, without modifying any Unraid source files.
      root.querySelectorAll('.tile, .openclose').forEach((control) =&gt; control.remove());
      Array.from(root.rows).forEach((row) =&gt; {
        const cell = row.cells[0];
        while (cell?.firstChild) section.append(cell.firstChild);
      });
      const row = document.createElement('tr');
      row.className = 'dpm-adjustments-row cpu_open';
      const detail = processor.querySelector('tr.cpu_open');
      if (detail &amp;&amp; getComputedStyle(detail).display === 'none') row.style.display = 'none';
      const cell = document.createElement('td');
      cell.append(section);
      row.append(cell);
      processor.append(row);
      const spacer = root.previousElementSibling;
      if (spacer?.querySelector('.stopgap')) spacer.remove();
      root.remove();
      root = section;
    }
    root.dataset.initialized = '1';
    const el = (name) =&gt; root.querySelector(`[data-dpm="${name}"]`);
    let state;
    let busy = false;
    let sliding = false;
    let revision = 0;
    let frequencyBusy = false;
    const frequencyLabels = [];
    processor?.querySelectorAll('tr.cpu_open').forEach((row) =&gt; {
      const metrics = [];
      row.querySelectorAll('.load.resize').forEach((load) =&gt; {
        const cpuClass = Array.from(load.classList).find((name) =&gt; /^cpu\d+$/.test(name));
        if (!cpuClass) return;
        const metric = load.parentElement;
        metric.classList.add('dpm-cpu-metric');
        metrics.push(metric);
      });
      if (metrics.length) {
        row.cells[0].classList.add('dpm-cpu-row');
        if (metrics.length === 1) metrics[0].style.gridColumn = 'span 2';
        const load = metrics[0].querySelector('.load.resize');
        const cpuClass = Array.from(load.classList).find((name) =&gt; /^cpu\d+$/.test(name));
        const label = document.createElement('span');
        label.className = 'dpm-cpu-ghz';
        label.dataset.cpu = cpuClass.slice(3);
        label.textContent = '\u2014 GHz';
        label.title = 'Sampled core frequency';
        row.cells[0].append(label);
        frequencyLabels.push(label);
      }
    });
    const mhz = (khz) =&gt; `${(khz / 1000).toLocaleString(undefined, { maximumFractionDigits: 3 })} MHz`;
    const message = (text) =&gt; { el('message').textContent = text; el('message').hidden = !text; };
    function render(next) {
      state = next;
      el('hardware').textContent = next.drivers.length ? `${next.drivers.join(', ')} adjustment` : 'CPU adjustment';
      el('governor').replaceChildren();
      if (next.governor === null) el('governor').add(new Option('Mixed / unavailable', '', true, true));
      next.governors.forEach((governor) =&gt; el('governor').add(new Option(governor, governor, false, next.governor === governor)));
      el('governor').disabled = busy || !next.governor_supported;
      el('turbo').checked = next.turbo.enabled === true;
      el('turbo').indeterminate = next.turbo.supported &amp;&amp; next.turbo.enabled === null;
      el('turbo').disabled = busy || !next.turbo.supported;
      el('turbo-status').textContent = !next.turbo.supported ? 'Unavailable'
        : (next.turbo.enabled === null ? 'Mixed' : (next.turbo.enabled ? 'On' : 'Off'));
      const freq = next.frequency;
      const lower = Math.ceil(freq.min_khz / 100000) * 100;
      const upper = Math.floor(freq.max_khz / 100000) * 100;
      const selectable = freq.supported &amp;&amp; lower &lt;= upper;
      el('cap').disabled = busy || !selectable;
      el('cap-ticks').replaceChildren();
      el('cap-low').textContent = selectable ? mhz(lower * 1000) : '—';
      el('cap-high').textContent = selectable ? mhz(upper * 1000) : '—';
      el('cap').title = '';
      if (selectable) {
        el('cap').min = String(lower);
        el('cap').max = String(upper);
        el('cap').value = String(Math.max(lower, Math.min(upper, Math.round((freq.cap_khz ?? freq.max_khz) / 100000) * 100)));
        for (let tick = lower; tick &lt;= upper; tick += 100) {
          el('cap-ticks').append(new Option('', String(tick)));
        }
        el('cap-label').textContent = freq.cap_khz === null ? 'Mixed' : mhz(freq.cap_khz);
      } else {
        el('cap-label').textContent = freq.cap_khz === null ? 'Unavailable' : mhz(freq.cap_khz);
        el('cap').title = freq.supported
          ? 'No 100 MHz step fits within the current hardware limits.'
          : 'No writable frequency ceiling with a shared range is exposed by this machine.';
      }
      const unavailable = [];
      if (!next.governor_supported) unavailable.push('Governor selection is not available across all CPU policies.');
      if (!next.turbo.supported) unavailable.push('A writable Turbo Boost control is not exposed by this machine or firmware.');
      el('unsupported').hidden = !unavailable.length;
      el('unsupported').textContent = unavailable.join(' ');
      el('conflict').hidden = !next.tips_conflict;
      el('refresh').disabled = busy;
    }
    async function request(body, suffix = '') {
      const response = await fetch(endpoint + suffix, {
        method: body ? 'POST' : 'GET', credentials: 'same-origin', cache: 'no-store',
        headers: body ? { 'Content-Type': 'application/x-www-form-urlencoded' } : {},
        body: body ? body.toString() : undefined,
      });
      const text = await response.text();
      let result;
      try { result = JSON.parse(text); } catch (_) { throw new Error('Could not read CPU settings. Sign in again or refresh the dashboard.'); }
      if (!response.ok || result.error) throw new Error(result.error || `Request failed (${response.status}).`);
      return result;
    }
    async function refreshFrequencies() {
      if (frequencyBusy || document.hidden || !root.isConnected
        || !frequencyLabels.some((label) =&gt; label.getClientRects().length)) return;
      frequencyBusy = true;
      try {
        const result = await request(null, '?frequencies=1');
        frequencyLabels.forEach((label) =&gt; {
          const khz = result.frequencies_khz?.[label.dataset.cpu];
          label.textContent = Number.isFinite(khz) &amp;&amp; khz &gt; 0 ? `${(khz / 1000000).toFixed(2)} GHz` : '— GHz';
        });
      } catch (_) {
        frequencyLabels.forEach((label) =&gt; { label.textContent = '— GHz'; });
      } finally {
        frequencyBusy = false;
      }
    }
    async function refresh(quiet = false) {
      if (busy || sliding || document.hidden) return;
      const startedAt = revision;
      try {
        const next = await request();
        // Do not overwrite edits made while the status request was in flight.
        if (busy || sliding || startedAt !== revision) return;
        render(next);
        if (!quiet) message('');
      } catch (error) { message(error.message); }
    }
    el('governor').addEventListener('change', () =&gt; apply('governor'));
    el('turbo').addEventListener('change', () =&gt; apply('turbo'));
    el('cap').addEventListener('pointerdown', () =&gt; { sliding = true; revision++; });
    ['pointerup', 'pointercancel', 'blur'].forEach((event) =&gt; {
      el('cap').addEventListener(event, () =&gt; { sliding = false; });
    });
    el('cap').addEventListener('input', () =&gt; {
      el('cap-label').textContent = mhz(Math.round(Number(el('cap').value) * 1000));
      sliding = true;
      revision++;
    });
    el('cap').addEventListener('change', () =&gt; {
      sliding = false;
      apply('max_freq_khz');
    });
    el('refresh').addEventListener('click', () =&gt; {
      sliding = false;
      revision++;
      refresh();
      refreshFrequencies();
    });
    async function apply(field) {
      if (busy || !state) return;
      const values = {
        governor: el('governor').value,
        turbo: el('turbo').checked ? '1' : '0',
        max_freq_khz: String(Math.round(Number(el('cap').value) * 1000)),
      };
      const current = {
        governor: state.governor,
        turbo: state.turbo.enabled === null ? null : (state.turbo.enabled ? '1' : '0'),
        max_freq_khz: state.frequency.cap_khz === null ? null : String(state.frequency.cap_khz),
      };
      if (values[field] === current[field]) return;
      if (typeof window.csrf_token !== 'string' || !window.csrf_token) {
        render(state);
        message('Your Unraid session has expired. Refresh the dashboard.'); return;
      }
      const body = new URLSearchParams({ csrf_token: window.csrf_token });
      body.set(field, values[field]);
      busy = true;
      sliding = false;
      revision++;
      root.querySelectorAll('button, select, input').forEach((control) =&gt; { control.disabled = true; });
      message('');
      el('saving').hidden = false;
      try {
        const next = await request(body);
        busy = false;
        render(next);
        message('');
        refreshFrequencies();
      } catch (error) {
        busy = false;
        try { render(await request()); } catch (_) { if (state) render(state); }
        message(error.message);
      } finally {
        el('saving').hidden = true;
      }
    }
    refresh();
    refreshFrequencies();
    const frequencyTimer = frequencyLabels.length ? setInterval(() =&gt; {
      if (!root.isConnected) { clearInterval(frequencyTimer); return; }
      refreshFrequencies();
    }, 3000) : null;
    // Poll live values so changes made by Unraid or another plugin are visible.
    const timer = setInterval(() =&gt; {
      if (!root.isConnected) { clearInterval(timer); return; }
      refresh(true);
    }, 10000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</INLINE>
    <SHA256>a2b20b0faa2a7d1fd4554c9c1fe2aa6d0f924ba94a4c3029f0f80bf9619b8b13</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/scripts/power-mode" Mode="0755">
    <INLINE>#!/usr/bin/php
&lt;?php
/* SPDX-License-Identifier: GPL-2.0-only */
declare(strict_types=1);
require_once dirname(__DIR__).'/include/PowerControl.php';
try {
    $power = new \DashboardPowerMode\PowerControl();
    if (($argv[1] ?? '') === 'restore') {
        $state = $power-&gt;restore();
    } elseif (($argv[1] ?? '') === 'status') {
        $state = $power-&gt;status();
    } else {
        fwrite(STDERR, "Usage: power-mode status|restore\n");
        exit(2);
    }
    echo json_encode($state, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'dashboard-power-mode: '.$error-&gt;getMessage()."\n");
    exit(1);
}
</INLINE>
    <SHA256>66b6f4578e850306c8424b369218219cdfa57f0fd0c8636dd067f0a30d45bff9</SHA256>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/dashboard-power-mode/styles/power-mode.css" Mode="0644">
    <INLINE>/* SPDX-License-Identifier: GPL-2.0-only */
#dashboard-power-mode .dpm-body { padding: 4px 4px 0; white-space: normal; }
#dashboard-power-mode button { cursor: pointer; margin: 0; }
#dashboard-power-mode button:disabled { cursor: default; }
#dashboard-power-mode .tile-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
#dashboard-power-mode .tile-header-left { flex: 1; min-width: 0; }
#dashboard-power-mode .tile-header-right { flex-shrink: 0; margin-left: auto; }
#dashboard-power-mode .tile-header-right-controls { display: inline-flex; align-items: center; gap: 6px; }
#dashboard-power-mode .dpm-saving { display: inline-block; font-size: 12px; font-weight: normal; white-space: nowrap; }
#dashboard-power-mode .dpm-saving[hidden] { display: inline-block !important; visibility: hidden; }
#dashboard-power-mode .dpm-refresh { display: inline-flex; align-items: center; justify-content: center; width: 26px; min-width: 0; height: 26px; padding: 4px; border: 0; background: transparent; color: inherit; box-shadow: none; }
#dashboard-power-mode .dpm-refresh:disabled { opacity: .5; }
#dashboard-power-mode.dpm-adjustments { border-top: 1px solid rgba(128,128,128,.3); margin-top: 8px; padding-top: 10px; }
#dashboard-power-mode .dpm-heading { margin: 0; font-size: 12px; font-weight: normal; line-height: 1.5; text-transform: none; white-space: normal; }
#dashboard-power-mode .dpm-conflict { font-size: 12px; font-weight: normal; opacity: .7; }
#dashboard-power-mode .dpm-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
#dashboard-power-mode select { max-width: 100%; margin: 0; min-width: 130px; }
#dashboard-power-mode #dpm-governor { flex: 0 0 50%; width: 50%; max-width: 50%; min-width: 0; margin: 0 0 0 auto; box-sizing: border-box; }
#dashboard-power-mode .dpm-toggle { display: inline-flex; align-items: center; gap: 8px; }
#dashboard-power-mode input[type="checkbox"] { margin: 0; accent-color: #e78d22; }
#dashboard-power-mode input[type="range"] { display: block; width: 100%; margin: 8px 0; accent-color: #e78d22; }
#dashboard-power-mode .dpm-limits { display: flex; justify-content: space-between; font-size: 12px; line-height: 1.5; }
#dashboard-power-mode .dpm-note { font-size: 12px; line-height: 1.5; opacity: .8; margin: 8px 0; }
#dashboard-power-mode [hidden] { display: none !important; }
.dpm-cpu-row { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1.5fr) minmax(0,1.5fr) 8ch; gap: 6px; align-items: center; }
.dpm-cpu-row &gt; span { width: auto !important; max-width: none !important; min-width: 0; justify-self: stretch; }
.dpm-cpu-row &gt; .dpm-cpu-metric { display: inline-flex; align-items: center; gap: 4px; }
.dpm-cpu-metric &gt; .load { flex: 0 0 4ch; width: 4ch !important; min-width: 0; }
.dpm-cpu-metric &gt; .usage-disk { flex: 1 1 auto; min-width: 10px; width: auto !important; margin: 0 !important; }
.dpm-cpu-ghz { flex: 0 0 8ch; font-size: 12px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }

#dashboard-power-mode [data-dpm="hardware"] { font-weight: bold; }
.dpm-adjustments-row &gt; td { padding-bottom: 0 !important; }
</INLINE>
    <SHA256>f31a15d18a247fb0e83a7913ca5bc39418f0dba800c1c3f47edd18cc6957bffa</SHA256>
  </FILE>
  <FILE Run="/bin/bash" Method="install">
    <INLINE>#!/bin/bash
set -eu
mkdir -p /boot/config/plugins/dashboard-power-mode
chmod 0700 /boot/config/plugins/dashboard-power-mode || true
if [ -s /boot/config/plugins/dashboard-power-mode/settings.json ]; then
  if ! /usr/local/emhttp/plugins/dashboard-power-mode/scripts/power-mode restore &gt;/dev/null; then
    logger -t dashboard-power-mode 'Saved CPU settings could not be restored; inspect the dashboard and syslog.'
  fi
fi
echo "Dashboard Power Mode installed. Open Dashboard to use the controls."
</INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>#!/bin/bash
set -eu
rm -rf -- /usr/local/emhttp/plugins/dashboard-power-mode
echo "Dashboard Power Mode removed. Saved settings are retained; current CPU settings remain until changed or rebooted."
</INLINE>
  </FILE>
</PLUGIN>
