  &lt;div class="dpm-row"&gt;&lt;label for="dpm-turbo"&gt;Turbo Boost&lt;/label&gt;&lt;span class="dpm-toggle"&gt;&lt;input id="dpm-turbo" data-dpm="turbo" type="checkbox" disabled aria-describedby="dpm-turbo-status"&gt;&lt;span id="dpm-turbo-status" data-dpm="turbo-status"&gt;Unavailable&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
